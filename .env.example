# RemoteMusicRP example environment. Copy to .env for local development.
# Placeholders only. NEVER commit real values.
# Credentials (Last.fm key, Discord app ID, email) are normally entered in the setup wizard and stored encrypted.

# Address the web UI binds to. Keep 127.0.0.1 unless you put a TLS reverse proxy in front.
REMOTEMUSICRP_BIND=127.0.0.1:8484

# Data directory (SQLite database).
REMOTEMUSICRP_DATA_DIR=./data

# Docker/server only: path to the master-key file (0600, on a separate volume from the data dir).
# REMOTEMUSICRP_MASTER_KEY_FILE=/run/secrets/remotemusicrp_master_key

# Optional TOML config file (see docs; env vars override it).
# REMOTEMUSICRP_CONFIG=./remotemusicrp.toml

# Poll interval in seconds (3–300, default 5).
# REMOTEMUSICRP_POLL_INTERVAL_SECS=5

# Daily update check (true/false).
# REMOTEMUSICRP_UPDATE_CHECK=true

# Log level: error | warn | info | debug
REMOTEMUSICRP_LOG=info
