# RemoteMusicRP as a hardened system service (deb/rpm/Arch packages).
#
# Enable with:  sudo systemctl enable --now remotemusicrp
# Settings:     /etc/remotemusicrp/remotemusicrp.toml
# Data:         /var/lib/remotemusicrp/data   (SQLite)
# Master key:   /var/lib/remotemusicrp/keys   (0600, outside the data dir)
#
# The web UI listens on 127.0.0.1:8484. To reach it from another machine,
# put a TLS reverse proxy in front (examples in /usr/share/doc/remotemusicrp)
# and set public_origin in the config.

[Unit]
Description=RemoteMusicRP (Last.fm to Discord Rich Presence)
Documentation=https://github.com/iammarxg/RemoteMusicRP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/remotemusicrp --config /etc/remotemusicrp/remotemusicrp.toml run
Environment=REMOTEMUSICRP_INSTALL_KIND=package
Restart=on-failure
RestartSec=5s

# A throwaway user that exists only while the service runs.
DynamicUser=yes
StateDirectory=remotemusicrp remotemusicrp/data remotemusicrp/keys
StateDirectoryMode=0700
UMask=0077

# Sandboxing. The app needs: outbound HTTPS, its state directory, and (server
# mode only) to read the Discord Social SDK library you downloaded.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
